<Window x:Class="PuntoFlower.Views.DetallesPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalles del Pedido" Height="550" Width="400"
        WindowStartupLocation="CenterOwner" Background="#FDFEFE">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="lblCliente" Text="Cliente" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock x:Name="lblFecha" Text="Fecha" Foreground="#7F8C8D" Margin="0,0,0,15"/>

            <Border Background="#EBF5FB" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="PEDIDO:" FontWeight="Bold" FontSize="10" Foreground="#2980B9"/>
                    <TextBlock x:Name="lblDescripcion" Text="Cargando..." FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="DEDICATORIA / NOTA:" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBox x:Name="txtNota" IsReadOnly="True" Height="80" TextWrapping="Wrap" Background="#F4F6F7" BorderThickness="0" Padding="5"/>

            <TextBlock Text="DIRECCIÓN:" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBlock x:Name="lblDireccion" Text="Cargando..." TextWrapping="Wrap" Margin="0,0,0,15"/>

            <Border Background="#FDEDEC" Padding="15" CornerRadius="8" BorderBrush="#FADBD8" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Total del Arreglo:" Foreground="#7B241C"/>
                        <TextBlock x:Name="lblTotal" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Anticipo dejado:" Foreground="#7B241C"/>
                        <TextBlock x:Name="lblAnticipo" Text="$0.00" HorizontalAlignment="Right" Foreground="#27AE60" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Separator Background="#FADBD8" Margin="0,5"/>
                    <DockPanel>
                        <TextBlock Text="SALDO A COBRAR:" FontSize="16" FontWeight="Bold" Foreground="#C0392B"/>
                        <TextBlock x:Name="lblSaldo" Text="$0.00" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#C0392B"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button Content="MARCAR COMO ENTREGADO Y PAGADO" Click="btnEntregar_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" Height="45" 
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>