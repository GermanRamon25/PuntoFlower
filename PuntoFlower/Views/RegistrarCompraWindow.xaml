<Window x:Class="PuntoFlower.Views.RegistrarCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Surtido de Mercancía" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" Background="#FBFCFC">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="lblProveedor" Text="Proveedor: Florería Gya" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

            <TextBlock Text="1. ¿Qué producto llegó?" Foreground="#5D6D7E"/>
            <ComboBox x:Name="cbProductos" Height="35" Margin="0,5,0,15" DisplayMemberPath="Nombre" VerticalContentAlignment="Center"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Cantidad (Pz/Mazo)" Foreground="#5D6D7E"/>
                    <TextBox x:Name="txtCantidad" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Costo Unitario ($)" Foreground="#5D6D7E"/>
                    <TextBox x:Name="txtCosto" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <Border Background="#FEF9E7" Padding="10" CornerRadius="5" Margin="0,10">
                <TextBlock x:Name="lblTotal" Text="Total de esta entrada: $0.00" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#B7950B"/>
            </Border>

            <Button Content="FINALIZAR Y SURTIR STOCK" Click="btnGuardarSurtido_Click" 
                    Height="50" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>