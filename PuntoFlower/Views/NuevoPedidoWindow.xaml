<Window x:Class="PuntoFlower.Views.NuevoPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nuevo Pedido" Height="760" Width="470"
        WindowStartupLocation="CenterOwner" Background="#FBFCFC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock x:Name="lblTituloVentana" Text="Detalles del Pedido" FontSize="24" FontWeight="Bold" Foreground="#2E4053" Margin="0,0,0,20"/>

                <TextBlock Text="Nombre del Cliente" Foreground="#566573"/>
                <TextBox x:Name="txtCliente" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Teléfono" Foreground="#566573"/>
                        <TextBox x:Name="txtTelefono" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- CORRECCIÓN 1: Se dividió este espacio para acomodar Fecha y Hora -->
                    <UniformGrid Columns="2" Margin="5,0,0,0">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="Fecha Entrega" Foreground="#566573" FontSize="11"/>
                            <DatePicker x:Name="dpFecha" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Hora Aprox." Foreground="#566573" FontSize="11"/>
                            <ComboBox x:Name="cbHoraEntrega" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center" IsEditable="True">
                                <ComboBoxItem Content="09:00 AM"/>
                                <ComboBoxItem Content="10:00 AM"/>
                                <ComboBoxItem Content="11:00 AM"/>
                                <ComboBoxItem Content="12:00 PM"/>
                                <ComboBoxItem Content="01:00 PM"/>
                                <ComboBoxItem Content="02:00 PM"/>
                                <ComboBoxItem Content="03:00 PM"/>
                                <ComboBoxItem Content="04:00 PM"/>
                                <ComboBoxItem Content="05:00 PM"/>
                                <ComboBoxItem Content="06:00 PM"/>
                                <ComboBoxItem Content="07:00 PM"/>
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                </UniformGrid>

                <TextBlock Text="¿Qué pidió el cliente? (Ej: Ramo 24 Rosas Rojas)" Foreground="#566573" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDescripcion" Height="35" Margin="0,5,0,12" VerticalContentAlignment="Center" BorderBrush="#3498DB"/>

                <Border Background="#EBF5FB" Padding="10" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#AED6F1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📦 Flor Base a Descontar al Entregar (Inventario Diferido)" FontSize="11" FontWeight="Bold" Foreground="#1B4F72" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Seleccionar Flor de Mostrador:" FontSize="10" Foreground="#566573"/>
                                <ComboBox x:Name="cbProductoInventario" Height="30" Margin="0,3,0,0" DisplayMemberPath="Nombre" SelectedValuePath="Id" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cant. Tallos/Pzs:" FontSize="10" Foreground="#566573"/>
                                <TextBox x:Name="txtCantidadFlores" Height="30" Margin="0,3,0,0" Text="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Dirección de Entrega (Dejar vacío si recoge en tienda)" Foreground="#566573"/>
                <TextBox x:Name="txtDireccion" Height="50" Margin="0,5,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Nota para la Tarjeta / Dedicatoria" Foreground="#566573"/>
                <TextBox x:Name="txtNota" Height="50" Margin="0,5,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

                <Border Background="#F4F6F7" Padding="15" CornerRadius="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Finanzas del Pedido" FontWeight="Bold" Foreground="#2E4053" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Precio del Ramo ($)" FontSize="11" Foreground="#566573"/>
                                <TextBox x:Name="txtPrecioTotal" Height="30" Margin="0,5" VerticalContentAlignment="Center" TextChanged="CalcularSaldo"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Costo de Envío ($)" FontSize="11" Foreground="#E67E22" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtCostoEnvio" Height="30" Margin="0,5" VerticalContentAlignment="Center" Text="0" TextChanged="CalcularSaldo"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,5,0,0">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Anticipo Inicial ($)" FontSize="11" Foreground="#566573"/>
                                <TextBox x:Name="txtAnticipo" Height="30" Margin="0,5" VerticalContentAlignment="Center" Text="0" TextChanged="CalcularSaldo"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Método de Pago Anticipo" FontSize="11" Foreground="#566573"/>
                                <ComboBox x:Name="cbMetodoAnticipo" Height="30" Margin="0,5" SelectedIndex="0" VerticalContentAlignment="Center" SelectionChanged="cbMetodoAnticipo_SelectionChanged">
                                    <ComboBoxItem Content="Efectivo"/>
                                    <ComboBoxItem Content="Tarjeta"/>
                                    <ComboBoxItem Content="Transferencia"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid x:Name="panelTransferenciaAnticipo" Columns="2" Margin="0,5,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Cuenta Destino:" FontSize="11" Foreground="#2980B9" FontWeight="SemiBold"/>
                                <ComboBox x:Name="cbCuentaAnticipo" Height="28" Margin="0,3" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Núm. Referencia:" FontSize="11" Foreground="#2980B9" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtReferenciaAnticipo" Height="28" Margin="0,3" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border BorderThickness="0,1,0,0" BorderBrush="#E5E8E8" Margin="0,10,0,5" Padding="0,5,0,0"/>

                        <DockPanel Margin="0,5,0,0">
                            <TextBlock x:Name="lblTituloSaldo" Text="SALDO PENDIENTE:" FontWeight="Bold" Foreground="#CB4335" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblSaldo" Text="$0.00" FontWeight="Bold" FontSize="18" Foreground="#CB4335" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="btnGuardar" Grid.Row="1" Content="GUARDAR EN AGENDA" Height="50" Margin="0,5,0,0" 
                Background="#27AE60" Foreground="White" FontWeight="Bold" 
                Click="btnGuardar_Click" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>