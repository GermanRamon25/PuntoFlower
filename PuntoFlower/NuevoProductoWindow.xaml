<Window x:Class="PuntoFlower.Views.NuevoProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nueva Flor/Insumo" Height="450" Width="400" 
        WindowStartupLocation="CenterOwner" Background="#FBFCFC">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Datos del Producto" FontSize="22" FontWeight="Bold" Foreground="#A93226" Margin="0,0,0,20"/>

            <TextBlock Text="Nombre de la Flor (Ej: Rosa Blanca, Rosa Roja, Girasol)" Foreground="#566573"/>
            <TextBox x:Name="txtNombre" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center" 
                     ToolTip="Usa nombres específicos para que el sistema descuente la flor correcta"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Categoría" Foreground="#566573"/>
                    <ComboBox x:Name="cbCategoria" Height="30" Margin="0,5" SelectedIndex="0">
                        <ComboBoxItem Content="Venta"/>
                        <ComboBoxItem Content="Bodega"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Tipo de Venta" Foreground="#566573"/>
                    <ComboBox x:Name="cbTipo" Height="30" Margin="0,5" SelectedIndex="3">
                        <ComboBoxItem Content="Ramos"/>
                        <ComboBoxItem Content="Coronas"/>
                        <ComboBoxItem Content="Medallones"/>
                        <ComboBoxItem Content="Insumo"/>
                    </ComboBox>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,10">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Precio Compra ($)" Foreground="#566573"/>
                    <TextBox x:Name="txtPrecioCompra" Height="30" Margin="0,5" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Precio Venta ($)" Foreground="#566573"/>
                    <TextBox x:Name="txtPrecioVenta" Height="30" Margin="0,5" VerticalContentAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Stock Inicial" Foreground="#566573"/>
                    <TextBox x:Name="txtStockActual" Height="30" Margin="0,5" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Stock Mínimo" Foreground="#566573"/>
                    <TextBox x:Name="txtStockMinimo" Height="30" Margin="0,5" VerticalContentAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <Button Content="GUARDAR PRODUCTO" Height="45" Margin="0,20,0,0" 
                    Background="#2D5A27" Foreground="White" FontWeight="Bold" 
                    Click="btnGuardar_Click" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>