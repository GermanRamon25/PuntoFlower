<Window x:Class="PuntoFlower.Views.NuevoProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo: Registrar Nueva Flor" Height="500" Width="400" 
        WindowStartupLocation="CenterOwner" Background="#FBFCFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <StackPanel>
                <TextBlock Text="Registro de Catálogo" FontSize="22" FontWeight="Bold" Foreground="#A93226" Margin="0,0,0,20"/>

                <TextBlock Text="Nombre de la Flor (Ej: Rosa Blanca)" Foreground="#566573"/>
                <TextBox x:Name="txtNombre" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Categoría" Foreground="#566573"/>
                        <ComboBox x:Name="cbCategoria" Height="35" Margin="0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Venta"/>
                            <ComboBoxItem Content="Bodega"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Tipo de Venta" Foreground="#566573"/>
                        <ComboBox x:Name="cbTipo" Height="35" Margin="0,5" SelectedIndex="3">
                            <ComboBoxItem Content="Ramos"/>
                            <ComboBoxItem Content="Coronas"/>
                            <ComboBoxItem Content="Medallones"/>
                            <ComboBoxItem Content="Insumo"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Precio de Venta Sugerido ($)" Foreground="#566573" Margin="0,10,0,0"/>
                <TextBox x:Name="txtPrecioVenta" Height="35" Margin="0,5,0,15" VerticalContentAlignment="Center" FontWeight="Bold"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Stock Inicial" Foreground="#566573"/>
                        <TextBox x:Name="txtStockActual" Height="35" Margin="0,5" VerticalContentAlignment="Center" Text="0"/>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Stock Mínimo" Foreground="#566573"/>
                        <TextBox x:Name="txtStockMinimo" Height="35" Margin="0,5" VerticalContentAlignment="Center" Text="10"/>
                    </StackPanel>
                </UniformGrid>

                <Button Content="REGISTRAR EN CATÁLOGO" Height="50" Margin="0,20,0,10" 
                        Background="#2D5A27" Foreground="White" FontWeight="Bold" 
                        Click="btnGuardar_Click" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>