<UserControl x:Class="PuntoFlower.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpInicio" Width="150" Margin="0,0,20,0"/>

                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpFin" Width="150" Margin="0,0,20,0"/>

                <Button Content="GENERAR REPORTE" Click="btnGenerarReporte_Click" 
                        Background="#3498DB" Foreground="White" FontWeight="Bold" 
                        Padding="20,8" BorderThickness="0" Cursor="Hand"/>

                <Button Content="EXPORTAR PDF" Click="btnExportarPDF_Click" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                        Padding="20,8" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Columns="4" Height="100">
                <Border Background="#EAFAF1" Margin="5" CornerRadius="8" Padding="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="(+) Total Ventas" Foreground="#1D8348" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtRepVentas" Text="$0.00" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#FDEDEC" Margin="5" CornerRadius="8" Padding="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="(-) Egresos Tienda (Empleado)" Foreground="#CB4335" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtRepGastos" Text="$0.00" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF9E7" Margin="5" CornerRadius="8" Padding="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="(-) Egresos Admin (Surtido)" Foreground="#B7950B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtRepGastosAdmin" Text="$0.00" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#EBF5FB" Margin="5" CornerRadius="8" Padding="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="(=) Utilidad Disponible" Foreground="#2E86C1" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtRepUtilidad" Text="$0.00" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Column="1" Background="White" Margin="5" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="🏆 TOP 5 MÁS VENDIDOS" FontWeight="Bold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="70">
                        <DataGrid x:Name="dgTopVentas" AutoGenerateColumns="False" IsReadOnly="True" 
                                  HeadersVisibility="None" GridLinesVisibility="None" Background="Transparent" 
                                  BorderThickness="0" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Binding="{Binding Extra}" Width="Auto" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="INGRESOS (VENTAS)" FontWeight="Bold" Foreground="#1D8348" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="250">
                        <DataGrid x:Name="dgIngresos" AutoGenerateColumns="False" IsReadOnly="True" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90"/>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="EGRESOS TIENDA (EMPLEADO)" FontWeight="Bold" Foreground="#CB4335" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="250">
                        <DataGrid x:Name="dgEgresosEmpleado" AutoGenerateColumns="False" IsReadOnly="True" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90"/>
                                <DataGridTextColumn Header="Servicio / Gasto" Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="EGRESOS ADMIN (SURTIDO)" FontWeight="Bold" Foreground="#B7950B" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="250">
                        <DataGrid x:Name="dgEgresosAdmin" AutoGenerateColumns="False" IsReadOnly="True" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" SortMemberPath="Fecha" CanUserSort="True" Width="90"/>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="REPORTE DE MERMAS (PRODUCTO DAÑADO / PÉRDIDAS)" FontWeight="Bold" Foreground="#922B21" Margin="0,0,0,10"/>
            <Border Background="White" CornerRadius="10" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150">
                    <DataGrid x:Name="dgMermas" AutoGenerateColumns="False" IsReadOnly="True" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="120"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Monto}" Width="100"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Extra}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>