<Window x:Class="PuntoFlower.Views.SurtirStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traspaso de Inventario Interno" Height="280" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock x:Name="lblProducto" Text="Traspaso: Nombre de Flor" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBlock Text="Mover mercancía de Bodega (Cámara Fría) a Venta (Mostrador)" FontSize="11" Foreground="#7F8C8D" FontStyle="Italic" Margin="0,0,0,20"/>

            <TextBlock Text="¿Cuántas piezas vas a pasar a preparación de venta?" Foreground="#5D6D7E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCantidad" Height="38" Margin="0,0,0,25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#2980B9"/>

            <Button Content="CONFIRMAR TRASPASO INTERNO" Click="btnSurtir_Click" 
                    Background="#2980B9" Foreground="White" FontWeight="Bold" Height="48" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>