<UserControl x:Class="PuntoFlower.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PuntoFlower"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <local:RutaAImagenConverter x:Key="RutaAImagenConverter"/>

        <!-- ESTILO DE LAS TARJETAS (CARDS) -->
        <Style x:Key="BaseCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="#F2F4F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#D5DBDB" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DE LAS PESTAÑAS (TIPO CONFIGURACIÓN) -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock x:Name="TabText" Text="{Binding}" FontSize="14" FontWeight="SemiBold" Margin="12,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Margin="5,0" Padding="15,8" CornerRadius="15" Background="#F2F3F4" BorderThickness="0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#CF8282"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#D5DBDB" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FADBD8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FDFEFE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CF8282" Padding="20,15">
            <TextBlock Text="Gestión de Catálogo Visual" FontSize="24" FontWeight="Bold" Foreground="White"/>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">

            <TabItem Header="Flores e Insumos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl x:Name="icProductos">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BaseCardBorderStyle}" Width="190" Height="300">
                                    <StackPanel>
                                        <Border Height="150" Background="#FBFCFC" CornerRadius="15,15,0,0">
                                            <Image Source="{Binding RutaImagen, Converter={StaticResource RutaAImagenConverter}}" 
                                                   Stretch="Uniform" Margin="10"/>
                                        </Border>

                                        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Margin="10,8,10,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding PrecioVenta, StringFormat={}{0:C}}" Foreground="#27AE60" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,5"/>

                                        <!-- BOTONES REDISEÑADOS -->
                                        <Grid Margin="12,5,12,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Botón Eliminar Estilizado -->
                                            <Button Click="btnEliminarFoto_Click" Tag="{Binding}" Width="38" Height="34" Background="#FDEDEC" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand">
                                                <Button.Content>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                                </Button.Content>
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Botón Cambiar Foto Estilizado -->
                                            <Button Grid.Column="1" Content="Cambiar Foto" Click="btnSubirFoto_Click" Tag="{Binding}" Height="34" Background="#CF8282" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Fotos de Ramos (Mayoreo)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <WrapPanel x:Name="wpRamosMayoreo" HorizontalAlignment="Center">
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
