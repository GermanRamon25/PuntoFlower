<UserControl x:Class="PuntoFlower.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PuntoFlower"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:RutaAImagenConverter x:Key="RutaAImagenConverter"/>
    </UserControl.Resources>

    <Grid Background="#FDFEFE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#A93226" Padding="20,15">
            <TextBlock Text="Catálogo Visual de Ramos" FontSize="24" FontWeight="Bold" Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10">
            <ItemsControl x:Name="icProductos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Height="280" Margin="10" Background="White" CornerRadius="10" BorderBrush="#EEE" BorderThickness="1">
                            <StackPanel>
                                <Border Height="150" Background="#F2F3F4" CornerRadius="10,10,0,0">
                                    <Image Source="{Binding RutaImagen, Converter={StaticResource RutaAImagenConverter}}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Margin="10,5" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PrecioVenta, StringFormat={}{0:C}}" Foreground="Green" HorizontalAlignment="Center"/>

                                <Button Content="Subir Foto" 
                                        Click="btnSubirFoto_Click" 
                                        Tag="{Binding}" 
                                        Margin="10" Background="#A93226" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>