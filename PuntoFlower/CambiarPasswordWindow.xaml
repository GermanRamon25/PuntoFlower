<Window x:Class="PuntoFlower.Views.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seguridad - Actualizar Credenciales" Height="520" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="🔒 Panel de Seguridad Administrativa" FontSize="16" FontWeight="Bold" Foreground="#1E312F" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <TextBlock Text="Cambio seguro de usuario y clave de acceso" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,15" HorizontalAlignment="Center" FontStyle="Italic"/>

            <TextBlock Text="Nombre de Usuario Actual:" Foreground="#5D6D7E" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <TextBox x:Name="txtUsuarioActual" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12" Padding="5,0"/>

            <TextBlock Text="Nuevo Nombre de Usuario:" Foreground="#5D6D7E" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <TextBox x:Name="txtNuevoUsuario" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12" Padding="5,0"/>

            <Separator Background="#BDC3C7" Margin="0,5,0,12" Opacity="0.5"/>

            <TextBlock Text="Contraseña Actual:" Foreground="#5D6D7E" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPasswordActual" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Nueva Contraseña:" Foreground="#5D6D7E" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPasswordNueva" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Confirmar Nueva Contraseña:" Foreground="#5D6D7E" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPasswordConfirmar" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <UniformGrid Columns="2">
                <Button Content="Cancelar" IsCancel="True" Height="35" Margin="0,0,5,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="Guardar Cambios" Click="btnGuardar_Click" Height="35" Margin="5,0,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>