<Window x:Class="PuntoFlower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PuntoFlower"
        xmlns:views="clr-namespace:PuntoFlower.Views" 
        mc:Ignorable="d"
        Title="PuntoFlower - Gestión de Florería" 
        Height="700" Width="1200" 
        WindowStartupLocation="CenterScreen"
        Background="#FFFDF5">

    <Window.Resources>
        <!-- Estilo original del menú lateral -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,25,25,0" Margin="0,2,15,2">
                            <ContentPresenter VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FADBD8"/>
                    <Setter Property="Foreground" Value="#CF8282"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- NUEVO ESTILO: Embellecimiento del ComboBox Multi-Sucursal -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F4F6F6"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Fondo redondeado con ligero borde -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="15">
                            </Border>
                            <!-- Botón para desplegar (Flecha transparente sobre el fondo) -->
                            <ToggleButton x:Name="toggleButton" BorderBrush="Transparent" Background="Transparent" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Padding="0,0,10,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center">
                                <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#7F8C8D" VerticalAlignment="Center" Margin="0,2,5,0"/>
                            </ToggleButton>
                            <!-- Contenido del selector (Texto) -->
                            <ContentPresenter x:Name="contentPresenter" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" 
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <!-- Menú desplegable -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#E5E8E8" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="2,4,2,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2980B9"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de los items del ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5" Margin="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FB"/>
                                <Setter Property="Foreground" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4E6F1"/>
                                <Setter Property="Foreground" Value="#1A5276"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#CF8282">
            <StackPanel Margin="0,20,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,40">
                    <TextBlock Text="🌸" FontSize="28" Margin="0,0,10,0" Foreground="#FADBD8" VerticalAlignment="Center"/>
                    <TextBlock Text="PuntoFlower" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnDashboard" Style="{StaticResource MenuButtonStyle}" Click="btnDashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Resumen General" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnInventario" Style="{StaticResource MenuButtonStyle}" Click="btnInventario_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Inventario / Flores" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnCatalogo" Style="{StaticResource MenuButtonStyle}" Click="btnCatalogo_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Catálogo de Fotos" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnVentas" Style="{StaticResource MenuButtonStyle}" Click="btnVentas_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Punto de Venta" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnAgenda" Style="{StaticResource MenuButtonStyle}" Click="btnAgenda_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Agenda de Pedidos" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnReportes" Style="{StaticResource MenuButtonStyle}" Click="btnReportes_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reportes e Ingresos" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnGastos" Style="{StaticResource MenuButtonStyle}" Click="btnGastos_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTextoGastosButton" Text="Gastos y Surtido" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnCorteCaja" Style="{StaticResource MenuButtonStyle}" Click="btnCorteCaja_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Corte de Caja" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnConfiguracion" Style="{StaticResource MenuButtonStyle}" Click="btnConfiguracion_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Separator Background="White" Margin="20,20,20,10" Opacity="0.3"/>

                <Button Style="{StaticResource MenuButtonStyle}" Click="btnCerrarSesion_Click" Background="#A93226" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="30,0" Margin="15,10,15,5" CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#DDD"/>
                </Border.Effect>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Bienvenido al Sistema" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Selector de Sucursales con el nuevo estilo redondeado y moderno -->
                        <ComboBox x:Name="cmbSucursales" Width="180" Height="30" Margin="0,0,20,0" 
                                  VerticalAlignment="Center" SelectionChanged="CmbSucursales_SelectionChanged" 
                                  Visibility="Collapsed"
                                  Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="Matriz (Pruebas)" IsSelected="True"/>
                            <ComboBoxItem Content="Sucursal Los Mochis"/>
                            <ComboBoxItem Content="Sucursal Guasave"/>
                            <ComboBoxItem Content="Sucursal Culiacán"/>
                        </ComboBox>

                        <TextBlock x:Name="txtUsuarioLogueado" Text="Usuario: -" Foreground="#27AE60" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#BDC3C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtFechaActual" Text="Cargando fecha..." Foreground="#7F8C8D" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="15">
                <views:DashboardView />
            </ContentControl>
        </Grid>
    </Grid>
</Window>