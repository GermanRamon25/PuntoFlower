<Window x:Class="PuntoFlower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PuntoFlower"
        xmlns:views="clr-namespace:PuntoFlower.Views" 
        mc:Ignorable="d"
        Title="PuntoFlower - Gestión de Florería" 
        Height="650" Width="1100" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="PuntoFlower" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <Button x:Name="btnDashboard" 
                        Content="Resumen General" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Click="btnDashboard_Click"/>

                <Button x:Name="btnInventario" 
                        Content="Inventario / Flores" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Margin="0,10,0,0" 
                        Click="btnInventario_Click"/>

                <Button x:Name="btnVentas" 
                        Content="Punto de Venta" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Margin="0,10,0,0" 
                        Click="btnVentas_Click"/>
                
                <Button x:Name="btnAgenda" 
                        Content="Agenda de Pedidos" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Margin="0,10,0,0"/>

                <Button x:Name="btnReportes" 
                        Content="Reportes e Ingresos" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Margin="0,10,0,0"/>

                <Button x:Name="btnGastos" 
                        Content="Gastos y Surtido" 
                        Style="{StaticResource MenuButtonStyle}" 
                        Margin="0,10,0,0" 
                        Click="btnGastos_Click"/>

                <Separator Background="Gray" Margin="0,30,0,10"/>

                <Button x:Name="btnConfiguracion" 
                        Content="Configuración" 
                        Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Bienvenido al Sistema" 
                               VerticalAlignment="Center" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#333"/>

                    <TextBlock Text="17 de Marzo, 2026" 
                               DockPanel.Dock="Right" 
                               VerticalAlignment="Center" 
                               Foreground="#777"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1">
                <views:DashboardView />
            </ContentControl>
        </Grid>
    </Grid>
</Window>