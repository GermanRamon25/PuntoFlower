<UserControl x:Class="PuntoFlower.Views.CashCloseOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5"
             Loaded="UserControl_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="txtTituloCorte" Text="Corte de Caja Diario" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="txtEmpleadoEnTurno" Text="Empleado en turno: -" FontSize="14" Foreground="#7F8C8D" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Periodo:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" Foreground="#5D6D7E"/>
                <ComboBox x:Name="cmbPeriodo" Width="150" Height="35" VerticalContentAlignment="Center" Margin="0,0,15,0" SelectionChanged="cmbPeriodo_SelectionChanged">
                    <ComboBoxItem Content="Hoy" IsSelected="True"/>
                    <ComboBoxItem Content="Esta Semana"/>
                    <ComboBoxItem Content="Este Mes"/>
                </ComboBox>

                <Button x:Name="btnFinalizarCorte" Content="CERRAR TURNO E IMPRIMIR PDF" 
                        Click="btnFinalizarCorte_Click"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" 
                        Height="45" Padding="20,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Height="120" Margin="0,0,0,20">
            <Border Background="#EAFAF1" Margin="5" CornerRadius="10" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Efectivo Recibido (+)" Foreground="#1D8348" FontSize="14"/>
                    <TextBlock x:Name="txtTotalRecibido" Text="$0.00" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#FDEDEC" Margin="5" CornerRadius="10" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cambio Entregado (-)" Foreground="#CB4335" FontSize="14"/>
                    <TextBlock x:Name="txtTotalCambio" Text="$0.00" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#EBF5FB" Margin="5" CornerRadius="10" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Efectivo en Caja (=)" Foreground="#2E86C1" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="txtEfectivoReal" Text="$0.00" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15">
            <DockPanel>
                <TextBlock x:Name="txtSubtituloTabla" Text="Auditoría de Movimientos (Hoy)" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10" Foreground="#5D6D7E"/>
                <DataGrid x:Name="dgCorte" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                        <DataGridTextColumn Header="Producto/Servicio" Binding="{Binding ProductoNombre}" Width="*"/>
                        <DataGridTextColumn Header="Método Pago" Binding="{Binding MetodoPago}" Width="150"/>
                        <DataGridTextColumn Header="Ref/Depósito" Binding="{Binding NumeroReferencia}" Width="120"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Cambio" Binding="{Binding MontoCambio, StringFormat={}{0:C}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>