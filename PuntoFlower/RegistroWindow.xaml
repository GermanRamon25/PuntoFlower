<Window x:Class="PuntoFlower.RegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Usuario" Height="380" Width="320" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FDFEFE">
    <StackPanel Margin="25" VerticalAlignment="Center">
        <TextBlock Text="Nuevo Usuario" FontWeight="Bold" Margin="0,0,0,8" Foreground="#2E4053"/>
        <TextBox x:Name="txtNewUser" Height="35" Padding="5" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

        <TextBlock Text="Contraseña" FontWeight="Bold" Margin="0,0,0,8" Foreground="#2E4053"/>

        <!-- Contenedor de Password con Ojo -->
        <Grid Margin="0,0,0,30">
            <PasswordBox x:Name="txtNewPass" Height="35" Padding="5,0,35,0" VerticalContentAlignment="Center"/>

            <TextBox x:Name="txtNewPassRevelada" Height="35" Padding="5,0,35,0" 
                     VerticalContentAlignment="Center" Visibility="Collapsed"/>

            <Button x:Name="btnShowPass" Content="👁" FontFamily="Segoe UI Symbol" FontSize="16" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#95A5A6"
                    PreviewMouseDown="BtnShowPass_PreviewMouseDown" 
                    PreviewMouseUp="BtnShowPass_PreviewMouseUp"
                    MouseLeave="BtnShowPass_MouseLeave"/>
        </Grid>

        <Button Content="REGISTRAR" Click="BtnGuardar_Click" Height="45" 
                Background="#3498DB" Foreground="White" FontWeight="Bold" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Window>