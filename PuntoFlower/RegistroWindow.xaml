<Window x:Class="PuntoFlower.RegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Usuario" Height="350" Width="300" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Nuevo Usuario" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtNewUser" Height="30" Margin="0,0,0,15"/>

        <TextBlock Text="Contraseña" FontWeight="Bold" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtNewPass" Height="30" Margin="0,0,0,25"/>

        <Button Content="REGISTRAR" Click="BtnGuardar_Click" Height="40" 
                Background="#3498DB" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>