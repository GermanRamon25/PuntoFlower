<Window x:Class="PuntoFlower.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PuntoFlower - Acceso" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F8F9F9" ResizeMode="NoResize"
        AllowsTransparency="True" WindowStyle="None">
    <Border CornerRadius="20" Background="White" Margin="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#BDC3C7" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="20,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#F4F6F6" Offset="0"/>
                        <GradientStop Color="#EAECEE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Resources/icono.PuntoFlower.png" Height="100" Width="100" Margin="0,0,0,20"/>
                    <TextBlock Text="PuntoFlower" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" TextAlignment="Center"/>
                    <TextBlock Text="Gestión Integral" FontSize="14" Foreground="#7F8C8D" TextAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="¡Bienvenido!" FontSize="28" FontWeight="Bold" Foreground="#2E4053" Margin="0,0,0,10"/>
                    <TextBlock Text="Inicia sesión para continuar" FontSize="14" Foreground="#7F8C8D"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Usuario" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtUsername" Height="45" Padding="10" BorderThickness="0,0,0,2" BorderBrush="#D5DBDB" 
                             FontSize="14" Margin="0,0,0,25" Background="Transparent"/>

                    <TextBlock Text="Contraseña" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="txtPassword" Height="45" Padding="10" BorderThickness="0,0,0,2" BorderBrush="#D5DBDB" 
                                 FontSize="14" Margin="0,0,0,20" Background="Transparent"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="INICIAR SESIÓN" Click="BtnLogin_Click" 
                            Height="50" Background="#27AE60" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="¿No tienes cuenta? Regístrate aquí" Click="BtnAbrirRegistro_Click" 
                            Background="Transparent" Foreground="#3498DB" BorderThickness="0" 
                            Cursor="Hand" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>

            <Button Content="X" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="15" Background="Transparent" Foreground="#95A5A6" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>