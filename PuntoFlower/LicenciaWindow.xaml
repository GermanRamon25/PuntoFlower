<Window x:Class="PuntoFlower.LicenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activación de Licencia - PuntoFlower" Height="320" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8F9F9">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Activación del Sistema" FontSize="22" FontWeight="Bold" Foreground="#A93226" Margin="0,0,0,5"/>
            <TextBlock Text="El sistema no está activado en este equipo. Proporcione el código de hardware a su desarrollador para obtener su licencia." 
                       TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="12" Margin="0,0,0,20"/>

            <TextBlock Text="Código de Hardware (HWID) de este Equipo:" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBox x:Name="txtHWID" Height="35" Margin="0,5,0,15" Padding="5" IsReadOnly="True" 
                     VerticalContentAlignment="Center" Background="#EAECEE" FontWeight="SemiBold"/>

            <TextBlock Text="Ingrese su Clave de Licencia:" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBox x:Name="txtLicencia" Height="35" Margin="0,5,0,20" Padding="5" VerticalContentAlignment="Center" CharacterCasing="Upper"/>

            <Button Content="ACTIVAR SOFTWARE" Click="BtnActivar_Click" Height="20" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>